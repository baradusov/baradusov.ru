---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import { countByYear } from '../utils/posts';

const unsortedBooks = await getCollection('books');

const books = unsortedBooks.sort((a, b) => {
  if (a.id === 'Читаю') {
    return -1;
  }

  return Number(b.id) - Number(a.id);
});

const counter = countByYear(books);
---

<Layout title="Книги | Нуриль Барадусов" description="Книжная полка">
  <main>
    <h1>Книжная полка ({counter})</h1>

    <div class="bookshelf">
      {
        books.map((booksByYear) => (
          <section>
            <h2>{booksByYear.id}</h2>

            <ul class="grid">
              {booksByYear.data.map((book) => {
                return (
                  <li class="book-card">
                    <div class="cover-wrapper">
                      <img
                        src={book.coverUrl}
                        alt={`Обложка книги "${book.title}"`}
                        loading="lazy"
                        onerror="this.onerror=null; this.src='/books/book-placeholder.svg';"
                      />
                    </div>
                    <p class="book-title">{book.title}</p>
                    <p class="book-author">{book.author}</p>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .bookshelf > section + section {
    margin-top: var(--space-2xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-l);
  }

  .grid > li + li {
    margin-top: 0;
  }

  .book-card {
    display: flex;
    flex-direction: column;
  }

  .cover-wrapper {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--color-hover);
    border-radius: var(--radius);
    margin-bottom: var(--space-2xs);
  }

  .cover-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .book-author {
    font-size: var(--text-2xs);
    line-height: var(--leading-snug);
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-m);
    }
  }

  @media (max-width: 500px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-s);
    }

    .book-title {
      font-size: var(--text-2xs);
    }
  }
</style>
