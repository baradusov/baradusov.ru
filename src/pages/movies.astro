---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import { countByYear, sortByShelf } from '../utils/posts';

const unsortedMovies = await getCollection('movies');

const movies = sortByShelf(unsortedMovies);
const counter = countByYear(movies);
---

<Layout title="Фильмы | Нуриль Барадусов" description="Просмотренные фильмы">
  <main>
    <h1>Просмотренные фильмы ({counter})</h1>

    <div class="shelf">
      {
        movies.map((moviesByYear) => (
          <section>
            <h2>{moviesByYear.id}</h2>

            <ul class="grid">
              {moviesByYear.data.map((movie) => {
                return (
                  <li class="movie-card">
                    <div class="poster-wrapper">
                      <img
                        src={movie.posterUrl ?? '/movies/movie-placeholder.svg'}
                        alt={`Постер фильма «${movie.title}»`}
                        loading="lazy"
                        onerror="this.onerror=null; this.src='/movies/movie-placeholder.svg';"
                      />
                    </div>
                    <p class="movie-title">{movie.title}</p>
                    <p class="movie-meta">
                      {movie.releaseYear}
                      {movie.originalTitle ? ` · ${movie.originalTitle}` : null}
                    </p>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .shelf > section + section {
    margin-top: var(--space-2xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-l);
  }

  .grid > li + li {
    margin-top: 0;
  }

  .movie-card {
    display: flex;
    flex-direction: column;
  }

  .poster-wrapper {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--color-hover);
    border-radius: var(--radius);
    margin-bottom: var(--space-2xs);
  }

  .poster-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .movie-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .movie-meta {
    font-size: var(--text-2xs);
    line-height: var(--leading-snug);
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-m);
    }
  }

  @media (max-width: 500px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-s);
    }

    .movie-title {
      font-size: var(--text-2xs);
    }
  }
</style>
