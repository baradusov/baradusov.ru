---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { typographize, typographizeHtml } from '../utils/typography.mjs';
import { countByYear, formatDate, getPosts } from '../utils/posts';

/** Сколько показываем в модулях, где список усечён. */
const POSTS = 9;
const SHELF = 3;
const MOVIES = 6;

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const posts = await getPosts();

const books = await getCollection('books');
const booksCount = countByYear(books);

// В «Читаю» две книги, а полке нужно три — добираем последними дочитанными.
const lastYear = [...books]
  .filter((entry) => entry.id !== 'Читаю')
  .sort((a, b) => Number(b.id) - Number(a.id))[0];

const reading = [
  ...(books.find((entry) => entry.id === 'Читаю')?.data ?? []),
  ...(lastYear?.data ?? []),
].slice(0, SHELF);

const movies = (await getCollection('movies')).sort(
  (a, b) => Number(b.id) - Number(a.id),
);
const moviesCount = countByYear(movies);
const latestMovies = movies[0]?.data.slice(0, MOVIES) ?? [];

const POSTCARDS = 4;

const hello = typographizeHtml(`
  Меня зовут <em>Нуриль</em>. Я работаю фронтендером в финтехе и живу
  в <s>Самаре</s> → <s>Санкт-Петербурге</s> → Тбилиси. Здесь я собираю всё,
  чем <a href="/now">занимаюсь</a>, и пишу дневник.
`);
---

<Layout
  title="Нуриль Барадусов"
  description="Здесь я собираю всё, чем занимаюсь и пишу дневник.">
  <main class="hub">
    <div class="modules">
      <section class="module module--hello">
        <SectionLabel title="Привет" />
        <p class="lead" set:html={hello} />
      </section>

      <section id="b-contacts" class="module module--contact">
        <SectionLabel title="Связь" count={4} />
        <ul class="entries">
          <li>
            <a href="https://t.me/nuril_notes">@nuril_notes</a> — телеграм-канал
          </li>
          <li><a href="https://t.me/baradusov">@baradusov</a> — телеграм</li>
          <li><a href="mailto:nuril@baradusov.ru">nuril@baradusov.ru</a></li>
          <li><a href="https://github.com/baradusov">гитхаб</a></li>
        </ul>
      </section>

      <section id="b-writings" class="module module--writing">
        <SectionLabel title="Пишу" count={posts.length} />
        <ul class="entries">
          {
            posts.slice(0, POSTS).map((post) => (
              <li class="entry">
                <a href={`/posts/${post.id}`}>{post.data.title}</a>
                <time datetime={String(post.data.created)}>
                  {formatDate(post.data.created, true)}
                </time>
              </li>
            ))
          }
        </ul>
        <p class="more"><a href="/archive">Весь архив →</a></p>
      </section>

      <section id="b-makings" class="module module--full">
        <SectionLabel title="Делаю" count={projects.length} />
        <ul class="projects">
          {
            projects.map((project) => (
              <li>
                <a href={project.data.url}>{project.data.name}</a>
                <p>{typographize(project.data.description)}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="module">
        <SectionLabel title="Читаю" count={booksCount} />
        <ul class="covers">
          {
            reading.map((book) => (
              <li>
                <img src={book.coverUrl} alt="" loading="lazy" />
                <p class="covers__title">{book.title}</p>
                <p class="covers__author">{book.author}</p>
              </li>
            ))
          }
        </ul>
        <p class="more"><a href="/books">Весь список →</a></p>
      </section>

      <section class="module">
        <SectionLabel title="Смотрю" count={moviesCount} />
        <ul class="entries">
          {
            latestMovies.map((movie) => (
              <li class="entry">
                <span>{movie.title}</span>
                <time>{movie.releaseYear}</time>
              </li>
            ))
          }
        </ul>
        <p class="more"><a href="/movies">Весь список →</a></p>
      </section>

      <section class="module module--full" data-guestbook>
        <SectionLabel title="Гостевая книга" />
        <ul class="cards">
          {
            Array.from({ length: POSTCARDS }).map(() => (
              <li class="card">
                <a class="card__link" href="/postcard">
                  <span class="card__paper">
                    <canvas class="card__canvas" width="480" height="800" />
                  </span>
                  <span class="card__who" />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="card__note" data-note hidden></p>
        <p class="more"><a href="/postcard">Все записки →</a></p>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { fetchPostcards, paintAll } from '../scripts/postcard-shared';

  // Всё ищем внутри: при переходе «назад» ClientRouter подменяет DOM,
  // и ссылки, взятые при загрузке модуля, указывали бы на старые узлы.
  const load = async () => {
    const root = document.querySelector<HTMLElement>('[data-guestbook]');
    if (!root) return;

    const items = [...root.querySelectorAll<HTMLElement>('.card')];
    const note = root.querySelector<HTMLElement>('[data-note]');
    if (!items.length) return;

    const say = (text: string) => {
      items.forEach((item) => item.remove());
      if (!note) return;
      note.textContent = text;
      note.hidden = false;
    };

    let cards;

    try {
      cards = await fetchPostcards(items.length);
    } catch {
      say('Не получилось загрузить записки.');
      return;
    }

    if (!cards.length) {
      say('Пока пусто — можно быть первым.');
      return;
    }

    items.forEach((item, index) => {
      const card = cards[index];

      if (!card) {
        item.remove();
        return;
      }

      const canvas = item.querySelector<HTMLCanvasElement>('.card__canvas');
      const who = item.querySelector<HTMLElement>('.card__who');
      const ctx = canvas?.getContext('2d');

      if (ctx) paintAll(ctx, card.strokes);

      if (who) who.textContent = card.message;
    });
  };

  document.addEventListener('astro:page-load', load);
</script>

<style is:global>
  body:has(.hub) {
    max-width: var(--page-width-wide);
  }

  /* Шапка и подвал остаются в текстовой колонке: широкая сетка — только
     для модулей. */
  body:has(.hub) header > *,
  body:has(.hub) footer {
    max-width: var(--page-width);
    margin-inline: auto;
  }
</style>

<style>
  .hub {
    padding-inline: var(--space-l);
  }

  .modules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l);
    align-items: stretch;
  }

  .module--full {
    grid-column: 1 / -1;
  }

  /* Слева «Привет» и «Связь», справа во всю их высоту — «Пишу». */
  .module--hello {
    grid-column: 1;
    grid-row: 1;
  }

  .module--contact {
    grid-column: 1;
    grid-row: 2;
  }

  .module--writing {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  /* Идиома открытки из гостевой: рамка и жёсткая тень, без скруглений. */
  .module {
    display: flex;
    flex-direction: column;
    padding: var(--space-m);
    border: 2px solid var(--color-ink);
    background: var(--color-bg);
    box-shadow: 5px 5px 0 var(--color-rule);
  }

  .module > * + * {
    margin-top: var(--space-s);
  }

  /* Прижата к низу, чтобы край модулей совпадал при любой длине списка. */
  .more {
    margin-top: auto;
    padding-top: var(--space-s);
  }

  .lead {
    font-size: var(--text-l);
    line-height: var(--leading-snug);
  }

  .entries > li + li {
    margin-top: var(--space-xs);
  }

  .entry {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .entry time {
    flex: none;
    font-size: var(--text-s);
    font-variant-numeric: tabular-nums;
  }

  /* Подобрана так, чтобы «Читаю» кончалось вровень со «Смотрю». */
  .covers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
    max-width: 360px;
  }

  .more {
    font-size: var(--text-s);
  }

  .covers img {
    aspect-ratio: 2 / 3;
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-2xs);
  }

  .covers__title {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .covers__author {
    font-size: var(--text-2xs);
    line-height: var(--leading-snug);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m) var(--space-l);
  }

  .projects > li {
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-rule);
  }

  /* Верхний ряд без линейки — её уже провёл ярлык. Колонок ровно три. */
  .projects > li:nth-child(-n + 3) {
    padding-top: 0;
    border-top: 0;
  }

  /* --- Гостевая книга --- */

  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .card__link {
    display: block;
    text-decoration: none;
  }

  .card__paper {
    display: block;
    border: 2px solid var(--color-ink);
    background: var(--color-paper);
  }

  .card__canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 5;
  }

  .card__who {
    display: block;
    margin-top: var(--space-2xs);
    font-size: var(--text-2xs);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  /* Держит строку, когда подписи нет: иначе карточки разной высоты. */
  .card__who::after {
    content: '\200b';
  }

  .card__link:hover .card__who {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .card__note {
    font-size: var(--text-s);
  }

  @media (max-width: 700px) {
    .hub {
      padding-inline: var(--space-xs);
    }

    .modules {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .module--full,
    .module--hello,
    .module--contact,
    .module--writing {
      grid-column: auto;
      grid-row: auto;
    }

    .projects {
      grid-template-columns: minmax(0, 1fr);
    }

    /* В одну колонку верхний ряд — это первый проект. */
    .projects > li:nth-child(-n + 3) {
      padding-top: var(--space-xs);
      border-top: 1px solid var(--color-rule);
    }

    .projects > li:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
