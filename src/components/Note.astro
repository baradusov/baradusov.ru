---
import type { CollectionEntry } from 'astro:content';
import { getEntry, render } from 'astro:content';

import { notePlainText } from '../utils/posts';

interface Props {
  note: CollectionEntry<'notes'>;
  /** На странице заметки заголовок — h1, в ленте — h2. */
  heading?: 'h1' | 'h2';
}

const { note, heading = 'h2' } = Astro.props;
const { Content } = await render(note);

const Heading = heading;
const created = new Date(note.data.created);
const date = created.toLocaleDateString('ru-RU');
const href = `/notes/${note.id}`;
/** Место заметки в ленте /notes. */
const anchor = `/notes#${note.id}`;

// Ответ показываем как в телеграме: плашка с началом исходной заметки.
const replyTo = note.data.replyTo
  ? await getEntry('notes', String(note.data.replyTo))
  : undefined;
const reply = replyTo && {
  href: `/notes#${replyTo.id}`,
  date: new Date(replyTo.data.created).toLocaleDateString('ru-RU'),
  title: replyTo.data.title,
  text: notePlainText(replyTo),
};
---

<article class="note" id={note.id}>
  {
    note.data.title ? (
      <Heading class="note__title">
        <a class="note__anchor" href={anchor}>
          #
        </a>{' '}
        {note.data.title}
      </Heading>
    ) : (
      <p class="note__head">
        <a class="note__anchor" href={anchor}>
          #
        </a>
      </p>
    )
  }

  {
    note.data.forwarded && (
      <p class="note__context">переслано из «{note.data.forwarded}»</p>
    )
  }

  {
    reply && (
      <a class="reply" href={reply.href}>
        <span class="reply__head">{reply.title ?? reply.date}</span>
        <span class="reply__text">{reply.text}</span>
      </a>
    )
  }

  <div class="content">
    <Content />
  </div>

  <p class="note__meta">
    <time datetime={created.toISOString()}><a href={href}>{date}</a></time>
    {' · '}
    <a href={`https://t.me/nuril_notes/${note.id}`}>в телеграме</a>
  </p>
</article>

<style>
  .note__context,
  .note__meta {
    font-size: var(--text-s);
  }

  .note__context {
    opacity: 0.7;
  }

  .note {
    scroll-margin-top: var(--space-m);
  }

  .note__anchor {
    text-decoration: none;
    opacity: 0.5;
  }

  .note__anchor:hover {
    opacity: 1;
  }

  .reply {
    display: block;
    padding: var(--space-2xs) var(--space-s);
    border-left: 2px solid var(--color-rule);
    background: var(--color-hover);
    font-size: var(--text-s);
    line-height: var(--leading-snug);
    text-decoration: none;
    color: inherit;
  }

  .reply:hover {
    border-left-color: var(--color-ink);
  }

  .reply__head {
    display: block;
    font-weight: var(--weight-bold);
  }

  .reply__text {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .note > * + * {
    margin-top: var(--space-s);
  }

  /* Альбом: несколько картинок одним абзацем — сеткой. */
  .content :global(p:has(> img + img)) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xs);
  }

  .content :global(p:has(> img + img) > img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1;
  }

  .content :global(video) {
    width: 100%;
    max-height: 80vh;
    background: var(--color-hover);
  }
</style>
