---
/**
 * Ярлык раздела: прописные вразрядку, счётчик и волосяная линейка.
 *
 * Разрядка 8 % — Баттерик советует 5–12 % при наборе прописными,
 * иначе буквы слипаются.
 */

interface Props {
  title: string;
  count?: number;
  href?: string;
}

const { title, count, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="section-label" href={href}>
  <span class="section-label__title">{title}</span>
  {count !== undefined && <span class="section-label__count">({count})</span>}
</Tag>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--color-rule);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .section-label__title {
    margin-right: auto;
  }

  a.section-label:hover .section-label__title {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .section-label__count {
    font-variant-numeric: tabular-nums;
  }
</style>
