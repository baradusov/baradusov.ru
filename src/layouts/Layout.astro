---
import { ClientRouter } from 'astro:transitions';

import DepthImage from '../components/DepthImage.astro';
import SlicedImage from '../components/SlicedImage.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const ogImage = image ?? 'https://baradusov.ru/hero.png';

const isIndex = Astro.url.pathname === '/';
const canonical = `https://baradusov.ru${Astro.url.pathname}`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="baradusov.ru"
      href="/feed.xml"
    />

    <ClientRouter />
  </head>
  <body>
    <header>
      {
        isIndex === false && (
          <a class="not-hero-link" href="/" aria-label="На главную">
            <SlicedImage
              src="/hero.png"
              heightPx={260}
              extraHeightPx={140}
              maxWidthPx={2560}
              focusY={0.9}
              cropHeight={0.65}
            />
          </a>
        )
      }

      {
        isIndex && (
          <DepthImage
            class="hero"
            src="/hero.png"
            depth="/hero-depth.png"
            alt=""
            width={772}
            height={686}
            cutout={{
              fill: '/hero-fill.png',
              mask: '/hero-mask.png',
              rect: [0.415486, 0.638004, 0.176582, 0.303609],
              depth: 0.749,
            }}
          />
        )
      }
    </header>

    <slot />

    <hr />

    <footer>
      <p>
        Следить за обновлениями на сайте можно через <a href="/feed.xml">RSS</a> или{
          ' '
        }<a href="https://t.me/nuril_notes">телеграм-канал</a>.
      </p>
    </footer>
  </body><style is:global>
    @import '../styles/global.css';

    /* --- Каркас страницы ------------------------------------------------ */

    header {
      padding-top: var(--space-m);
      margin-bottom: var(--space-xl);
    }

    main,
    footer {
      padding-inline: var(--space-xs);
    }

    /* Заголовок страницы держится ближе к своему содержимому,
       чем секции друг к другу. */
    main > h1 + * {
      margin-top: var(--space-block);
    }

    footer {
      font-size: var(--text-s);
    }

    /* --- Лента постов на главной ---------------------------------------- */

    .feed section {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
    }

    /* В сетке ритм задают колонки, а не вертикальные отступы: обе колонки
       начинаются от верха строки, иначе год уезжает от списка. */
    .feed .year,
    .feed .posts {
      margin-top: 0;
    }

    .feed .year {
      grid-column: 1;
    }

    .feed .posts {
      grid-column: 2 / -1;
    }

    .feed .posts > li + li {
      margin-top: var(--space-xs);
    }

    .feed .post-link {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-m);
    }

    /* Год и заголовки постов набраны одинаково — за счёт этого первые строки
       в колонках стоят на одной базовой линии. */
    .feed .year,
    .feed .post-link h3 {
      font-size: var(--text-l);
      line-height: var(--leading-snug);
    }

    .feed .post-link h3 {
      text-wrap: pretty;
    }

    .feed .post-link time {
      flex: none;
    }

    @media (min-width: 601px) {
      .feed .year {
        position: sticky;
        top: 0;
        align-self: self-start;
      }
    }

    @media (max-width: 600px) {
      .feed section {
        display: block;
      }

      .feed .year {
        margin-bottom: var(--space-s);
      }
    }

    .feed > * + * {
      margin-top: var(--space-block);
    }

    /* --- Шапка с картинкой ---------------------------------------------- */

    .hero {
      width: 100%;
    }

    .not-hero-link {
      position: relative;
      display: block;
      overflow: visible;
      text-decoration: none;
      /* full-bleed: break out of the centered column */
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }

    @media (max-width: 600px) {
      .hero {
        height: 533px;
      }
    }
  </style>

  <script is:inline>
    if (window.navigator && navigator.serviceWorker) {
      navigator.serviceWorker.getRegistrations().then(function (registrations) {
        for (let registration of registrations) {
          registration.unregister();
        }
      });
    }
  </script>
</html>
